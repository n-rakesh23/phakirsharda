# Hostinger / Apache / LiteSpeed configuration for the React single-page app.
# Vite copies this file from public/ into dist/ on every build.

Options -MultiViews
RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# SPA fallback: serve real files and folders as-is; send every other path
# (e.g. /about, /businesses/mining) to index.html so React Router can render it.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ index.html [L]

# Caching: hashed build assets can be cached for a year; index.html must always be fresh
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|webp|jpg|jpeg|png|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
